#!/bin/sh
# Candado (regla 26): corre scripts/check.sh antes de cada push; si falla, no se sube nada.
# Emergencia: `git push --no-verify` (decirlo en el PR; el check del hosting o del CI igual revisa).

# Borrar una rama remota no sube código: no hay nada que probar.
hay_codigo=0
while read -r _local sha_local _remota _sha_remota; do
  case "$sha_local" in
    0000000000000000000000000000000000000000) ;;
    *) hay_codigo=1 ;;
  esac
done
[ "$hay_codigo" = 1 ] || exit 0

echo "pre-push: corriendo scripts/check.sh…"
if bash scripts/check.sh; then
  echo "pre-push: todo pasó."
else
  echo "pre-push: algo falló; no se subió nada. Corrige y vuelve a intentar." >&2
  exit 1
fi
